{
  "name": "dsh-price-badge",
  "version": "0.2.0",
  "description": "DeepSeek 峰谷费用时段徽章：右下角显示当前处于高峰还是空闲时段（含周末与中国法定节假日判定），点击展开官方人民币价格表（deepseek-flash / deepseek-v4-pro）。",
  "type": "module",
  "main": "lib/index.js",
  "exports": {
    ".": "./lib/index.js",
    "./client": "./lib/client.js",
    "./package.json": "./package.json"
  },
  "dsh": {
    "client": {
      "inject": ["@deepseek-ai/dsh-client-runtime"],
      "platform": "web"
    },
    "bundle": {
      "patch": "./cordis.patch.yml"
    }
  },
  "license": "MIT"
}
